{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "functions": {
        "**/*.py": {
          "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,.venv/**,output/*.csv,output/*.log}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
